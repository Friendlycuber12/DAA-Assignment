class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        merged = nums1 + nums2
        merged.sort()
        n = len(merged)
        if n % 2 == 1:
            return merged[n // 2]
        else:
            mid = n // 2
            mid2 = mid - 1
            return (merged[mid] + merged[mid2])/2
